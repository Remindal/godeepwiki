# ---- 保留项（密钥，禁止落 yaml） ----
# 普通 API key 列表，逗号分隔；留空 = 开发模式（跳过鉴权并 WARN）
DEEPWIKI_API_KEYS=
# admin key（PUT /api/v1/config 用）
DEEPWIKI_ADMIN_KEY=
# Embedding provider 密钥（yaml 不落明文）
DEEPWIKI_EMBEDDING_API_KEY=
# LLM provider 密钥（yaml 不落明文）
DEEPWIKI_LLM_API_KEY=

# ---- 新增项（基础设施坐标与凭据，禁止落 yaml） ----
# Postgres DSN（开发态指向 docker-compose 的 postgres 服务）
DEEPWIKI_POSTGRES_DSN=postgres://deepwiki:deepwiki@postgres:5432/deepwiki?sslmode=disable
# OpenSearch 认证（开发态 plugins.security.disabled=true，可留空）
DEEPWIKI_OPENSEARCH_USERNAME=
DEEPWIKI_OPENSEARCH_PASSWORD=
# OpenSearch 地址（容器网络内服务名）
OPENSEARCH_ADDRESSES=http://opensearch:9200
# RabbitMQ 连接 URL（开发态指向 docker-compose 的 rabbitmq 服务）
DEEPWIKI_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Redis 哨兵地址列表（容器网络内服务名，内部端口均为 26379）
DEEPWIKI_REDIS_SENTINEL_ADDRESSES=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
# Redis 密码（开发态无密码，留空）
DEEPWIKI_REDIS_PASSWORD=
# etcd 端点列表（容器网络内服务名）
ETCD_ENDPOINTS=etcd:2379
